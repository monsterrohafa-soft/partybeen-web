// Prisma Schema for Partybeen Portfolio System
// Vercel Postgres 사용

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 관리자 계정 (NextAuth)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique  // 아이디로 사용 (이메일 형식 아니어도 됨)
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  notices       Notice[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  ADMIN
}

// 포트폴리오 카테고리
model Category {
  id          String      @id @default(cuid())
  name        String      // 표시 이름 (예: "CATERING")
  slug        String      @unique // URL용 (예: "catering")
  description String?
  portfolios  Portfolio[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// 포트폴리오 아이템
model Portfolio {
  id            String      @id @default(cuid())
  title         String
  description   String?
  content       String?     @db.Text // 상세페이지용 본문 내용
  imageUrl      String      // Vercel Blob URL
  imagePosition String?     // 이미지 위치 (예: "50% 30%") - object-position용
  externalUrl   String?     // 언론보도용 외부 링크 (null이면 일반 포트폴리오)
  displayMode   DisplayMode @default(MODAL) // 모달 또는 상세페이지
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  orderIndex    Int         @default(0)
  isVisible     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([categoryId])
  @@index([orderIndex])
}

// 표시 모드
enum DisplayMode {
  MODAL  // 모달로 표시
  DETAIL // 상세페이지로 이동
}

// 메뉴 카테고리
model MenuCategory {
  id          String   @id @default(cuid())
  name        String   // 표시 이름 (예: "메인 요리")
  slug        String   @unique
  description String?
  orderIndex  Int      @default(0)
  isVisible   Boolean  @default(true)
  menus       Menu[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderIndex])
}

// 메뉴 아이템
model Menu {
  id             String       @id @default(cuid())
  name           String       // 메뉴 이름
  description    String?      // 간단 설명
  content        String?      @db.Text // 상세페이지용 본문 내용
  price          String?      // 가격 (문자열로 "10,000원~" 등 표현)
  imageUrl       String       // 썸네일 이미지
  detailImageUrl String?      // 상세페이지용 이미지 (세로로 긴 이미지)
  displayMode    DisplayMode  @default(MODAL) // 모달 또는 상세페이지
  categoryId     String
  category       MenuCategory @relation(fields: [categoryId], references: [id])
  orderIndex     Int          @default(0)
  isVisible      Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([categoryId])
  @@index([orderIndex])
}

// 공지사항
model Notice {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text // 긴 텍스트 지원
  isVisible Boolean  @default(true)
  isPinned  Boolean  @default(false) // 상단 고정
  viewCount Int      @default(0)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isVisible, isPinned, createdAt])
}

// 제안서 (PDF)
model Proposal {
  id        String   @id @default(cuid())
  title     String   // 제안서 제목
  filename  String   // 원본 파일명
  fileUrl   String   // Vercel Blob URL
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 사이트 설정 (SMTP 등)
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique // 설정 키 (예: "smtp_email", "smtp_password")
  value     String   // 설정 값 (암호화 필요한 경우 암호화해서 저장)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
